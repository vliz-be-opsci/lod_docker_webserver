# ==========================================
# Stage 1: Build the static LOD website (both dist and dist-gapped)
# ==========================================
FROM oven/bun:1.1 AS builder

WORKDIR /app

# Copy configuration files and install dependencies
COPY package.json tsconfig.json ./
RUN bun install --frozen-lockfile

# Copy generator files and assets
COPY generator/ ./generator/
COPY wrx.pdf ./wrx.pdf

# Set environment variables for build time
ENV BASE_URL=http://localhost:8080
ENV BASE_URL_GAPPED=http://localhost:8081
ENV GEN_LIMIT=150

# Run generator to build all pages and configs for both dist and dist-gapped
RUN bun run generate

# ==========================================
# Stage 2: Serve Gapped Instance using Nginx
# ==========================================
FROM nginx:alpine

# Copy custom Gapped Nginx configuration
COPY nginx-gapped.conf /etc/nginx/nginx.conf

# Copy gapped static assets from builder stage
COPY --from=builder /app/dist-gapped/ /usr/share/nginx/html/

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
